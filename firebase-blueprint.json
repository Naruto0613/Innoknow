{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information, level progress, streak status, and subscription tier.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "paymentRef": { "type": "string" },
        "plan": {
          "type": "string",
          "enum": ["trial", "basic", "pro", "premium"]
        },
        "planStartDate": { "type": "string", "format": "date-time" },
        "planExpiry": { "type": "string", "format": "date-time" },
        "trialStartDate": { "type": "string", "format": "date-time" },
        "trialExpiry": { "type": "string", "format": "date-time" },
        "xp": { "type": "integer" },
        "streak": { "type": "integer" },
        "lastActiveDate": { "type": "string", "format": "date-time" },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "school": { "type": "string" },
        "lessonsCompleted": { "type": "integer" },
        "certificatesEarned": { "type": "array" },
        "battleWins": { "type": "integer" },
        "battleLosses": { "type": "integer" }
      },
      "required": ["uid", "email", "plan", "xp", "streak"]
    },
    "PaymentRequest": {
      "title": "Payment Request",
      "description": "Subscription request details that require verification and double administrator approvals.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "paymentRef": { "type": "string" },
        "plan": { "type": "string", "enum": ["pro", "premium"] },
        "amount": { "type": "integer" },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "rejected"]
        },
        "requestedAt": { "type": "string", "format": "date-time" },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "confirmedBy": { "type": "array" }
      },
      "required": [
        "userId",
        "userEmail",
        "paymentRef",
        "plan",
        "amount",
        "status",
        "requestedAt"
      ]
    },
    "Leaderboard": {
      "title": "Leaderboard Participant",
      "description": "Leaderboard ranking and point tallies indexed for speed.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "xp": { "type": "integer" },
        "streak": { "type": "integer" },
        "level": { "type": "string" },
        "school": { "type": "string" },
        "plan": { "type": "string" },
        "dailyXP": { "type": "integer" },
        "weeklyXP": { "type": "integer" },
        "allTimeXP": { "type": "integer" }
      },
      "required": ["userId", "name", "xp", "allTimeXP"]
    },
    "Battle": {
      "title": "Gamified Battle Duel",
      "description": "Academic speed battle session record between players.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "player1": { "type": "string" },
        "player2": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["vocabulary", "grammar", "listening"]
        },
        "winner": { "type": "string" },
        "xpAwarded": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["player1", "player2", "type", "createdAt"]
    },
    "Certificate": {
      "title": "Digital Performance Certificate",
      "description": "Competency or milestone achievement credentials.",
      "type": "object",
      "properties": {
        "certId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced", "streak100"]
        },
        "issuedAt": { "type": "string", "format": "date-time" },
        "qrCode": { "type": "string" }
      },
      "required": ["certId", "userId", "userName", "type", "issuedAt"]
    },
    "Feedback": {
      "title": "User Feedback",
      "description": "User suggestions, complaints, or bug reports submitted via feedback forms.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["bug", "suggestion", "compliment", "other"]
        },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "read", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "userName",
        "userEmail",
        "type",
        "message",
        "status",
        "createdAt"
      ]
    },
    "Vocabulary": {
      "title": "Vocabulary Word",
      "description": "An English word, translation, difficulty badge, and context examples for study.",
      "type": "object",
      "properties": {
        "word": { "type": "string" },
        "translation": { "type": "string" },
        "pos": { "type": "string", "enum": ["noun", "verb", "adj", "adv"] },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "category": { "type": "string" },
        "example": { "type": "string" },
        "exampleMn": { "type": "string" },
        "addedBy": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["word", "translation", "pos", "level", "category"]
    },
    "Lesson": {
      "title": "English Curriculum Lesson",
      "description": "Detailed multi-level core curriculum english lessons with key vocabulary & practice quizzes.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleMn": { "type": "string" },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "skill": {
          "type": "string",
          "enum": [
            "reading",
            "listening",
            "speaking",
            "writing",
            "grammar",
            "vocabulary",
            "Reading",
            "Listening",
            "Speaking",
            "Writing",
            "Grammar",
            "Vocabulary"
          ]
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard", "Easy", "Medium", "Hard"]
        },
        "xpReward": { "type": "integer" },
        "estimatedTime": { "type": "integer" },
        "description": { "type": "string" },
        "content": { "type": "object" },
        "isPremium": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "level",
        "skill",
        "difficulty",
        "xpReward",
        "content"
      ]
    },
    "Skill": {
      "title": "Localized Focus Course Skill",
      "description": "Interactive learning skills tasks, listening TTS passages, mini quizzes & prompts.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "topic": { "type": "string" },
        "instructionsMn": { "type": "string" },
        "instructionsEn": { "type": "string" },
        "xpReward": { "type": "integer" },
        "timeLimit": { "type": "integer" },
        "content": { "type": "object" },
        "isPremium": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "level", "xpReward", "isPublished"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User general profile tracking."
    },
    "paymentRequests/{userId}": {
      "schema": "PaymentRequest",
      "description": "Individual premium plan upgrade request tracking."
    },
    "leaderboard/{userId}": {
      "schema": "Leaderboard",
      "description": "Live leaderboard registers."
    },
    "battles/{battleId}": {
      "schema": "Battle",
      "description": "Academic multiplayer duel records."
    },
    "certificates/{certId}": {
      "schema": "Certificate",
      "description": "Earned certificates registers."
    },
    "feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback submissions."
    },
    "vocabulary/{wordId}": {
      "schema": "Vocabulary",
      "description": "Curated vocabulary database."
    },
    "lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Custom administrator interactive lessons."
    },
    "skills/{skillId}": {
      "schema": "Skill",
      "description": "Dynamic exercise challenges for students."
    }
  }
}
