rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Deny Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Since the application utilizes a custom client-side Auth session with localStorage,
    // we authorize users based on internal fields matching the path ID to protect cross-record writing,
    // bypassing direct cloud auth check requirements.

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && request.resource.data.uid == userId;
      allow delete: if true;
    }

    // PAYMENT REQUESTS
    match /paymentRequests/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && request.resource.data.userId == userId;
      allow delete: if true;
    }

    // LEADERBOARD COLLECTION
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && request.resource.data.uid == userId;
      allow delete: if true;
    }

    // BATTLES COLLECTION
    match /battles/{battleId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // CERTIFICATES COLLECTION
    match /certificates/{certId} {
      allow read: if true; // Certificates can be shared publicly via link
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
